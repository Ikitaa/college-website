{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodeNext",
    "lib": ["ES2020"],
    "types": ["node"],

    "outDir": "./dist",
    "rootDir": "./src",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "resolveJsonModule": true,
    "moduleResolution": "nodeNext",

    "declaration": false,
    "sourceMap": true
  },

  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}