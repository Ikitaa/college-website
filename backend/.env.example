PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local:   mongodb://127.0.0.1:27017/college_website
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/college_website
MONGO_URI=mongodb://127.0.0.1:27017/college_website

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Cookie
COOKIE_SECURE=false

# Frontend origin (for CORS)
CLIENT_URL=http://localhost:5173

# First admin account, created automatically on first server start
ADMIN_EMAIL=admin@college.edu.np
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Super Admin